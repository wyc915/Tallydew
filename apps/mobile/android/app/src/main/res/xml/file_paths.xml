<?xml version="1.0" encoding="utf-8"?>
<!-- Only the app's own export folder can be handed to other apps (share sheet).
     Shared storage as a whole is no longer exposed through the FileProvider. -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path name="exports" path="exports/" />
    <!-- Capacitor's WebView file chooser writes camera shots here (app-private Pictures dir) -->
    <external-files-path name="camera" path="Pictures/" />
</paths>
